{
	"name": "rpg-master-plugin",
	"version": "0.0.5",
	"description": "An Obsidian plugin to play RPG games with friends. This is the master plugin, which manages the game state and communicates with player plugins.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"build": "svelte-check --tsconfig ./tsconfig.json && vite build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"start_test_server": "vite test --host 127.0.0.1 --port 5173 --strictPort --open",
		"lint": "eslint .",
		"yalc:add:shared": "${YALC_BIN:-$HOME/.local/bin/yalc} link @0biwankenobi/rpg-shared && rm -rf node_modules/rpg_shared && ln -sfnT @0biwankenobi/rpg-shared node_modules/rpg_shared",
		"yalc:update:shared": "${YALC_BIN:-$HOME/.local/bin/yalc} update @0biwankenobi/rpg-shared",
		"yalc:remove:shared": "${YALC_BIN:-$HOME/.local/bin/yalc} remove @0biwankenobi/rpg-shared",
		"knip": "knip"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.30.1",
		"@jsrob/svelte-portal": "^0.2.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^20.19.43",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
		"knip": "^6.21.0",
		"playwright": "^1.61.1",
		"rollup-plugin-sourcemaps": "^0.6.3",
		"svelte": "^5.56.2",
		"svelte-check": "^4.6.0",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.2",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@journeyapps/wa-sqlite": "^2.0.3",
		"obsidian": "1.12.3",
		"rpg_shared": "npm:@0biwankenobi/rpg-shared@^0.0.7"
	}
}
